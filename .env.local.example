# Copy this file to .env.local and fill in real values.
# .env.local is gitignored - never commit real secrets.

# Google Gemini (server-side only - never expose to the browser)
GEMINI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (legacy/inactive - see README, migrating to Paddle)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_PRO=

# Paddle - client token + env are exposed to the browser (that's how Paddle.js
# works, they aren't secret); everything else is server-only.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_PREMIUM=
PADDLE_PRICE_PREMIUM_ANNUAL=
PADDLE_PRICE_PRO=
PADDLE_PRICE_PRO_ANNUAL=
PADDLE_PRICE_CREDIT_PACK=

# App
NEXT_PUBLIC_URL=http://localhost:3000

# Cron jobs (Vercel Cron auto-sends this as a Bearer token - see vercel.json)
CRON_SECRET=
